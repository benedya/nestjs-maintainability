{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@app/shared": ["libs/shared/src/index.ts"],
      "@app/shared/*": ["libs/shared/src/*"]
    },
    "outDir": "dist"
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts"]
}
