{
  "name": "nestjs-maintainability",
  "version": "0.1.0",
  "description": "Static maintainability and coupling metrics for NestJS codebases, per module, per file and app-wide.",
  "keywords": [
    "nestjs",
    "nest",
    "maintainability",
    "coupling",
    "cohesion",
    "architecture",
    "metrics",
    "static-analysis",
    "lcom4",
    "cognitive-complexity"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benedya/nestjs-maintainability#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benedya/nestjs-maintainability.git"
  },
  "bugs": {
    "url": "https://github.com/benedya/nestjs-maintainability/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nestjs-maintainability": "./dist/cli.js",
    "nest-ml": "./dist/cli.js"
  },
  "files": [
    "dist",
    "doc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@types/node": "^22.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
